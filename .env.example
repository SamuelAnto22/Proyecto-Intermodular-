# Midnight Customs — Environment Variables
# Copia este archivo a .env (fuera del web root en producción)
# y ajusta los valores según tu entorno.

# Base de datos
DB_HOST=127.0.0.1
DB_NAME=midnight_customs
DB_USER=root
DB_PASS=

# Entorno de la aplicación (local | production)
APP_ENV=local

# Complejidad de contraseña (true | false)
# local: false para facilitar pruebas
# production: true para exigir mayúscula, minúscula, número y símbolo
PASSWORD_REQUIRE_COMPLEXITY=false

# Configuración de sesión
SESSION_SAMESITE=Lax
